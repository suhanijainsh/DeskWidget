void fetchFlight() {
  if (!wifiConnected || WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi not connected");
    return;
  }

  HTTPClient http;
  String url = "https://opensky-network.org/api/states/all?lamin=12.7&lomin=77.4&lamax=13.2&lomax=77.9";

  Serial.println("\n🌐 Fetching flight data...");
  http.begin(url);

  int code = http.GET();
  if (code != 200) {
    Serial.print("❌ HTTP Error: ");
    Serial.println(code);
    http.end();
    return;
  }

  String payload = http.getString();
  Serial.println("📦 Payload (first 300 chars):");
  Serial.println(payload.substring(0, 300));

  DynamicJsonDocument doc(8192);
  DeserializationError error = deserializeJson(doc, payload);
  if (error) {
    Serial.print("❌ JSON Error: ");
    Serial.println(error.c_str());
    http.end();
    return;
  }

  JsonArray states = doc["states"];
  if (states.isNull() || states.size() == 0) {
    Serial.println("❌ No flights found");
    http.end();
    return;
  }

  // -------- grab top 3 valid flights --------
  flightCount   = 0;
  currentFlight = 0;

  for (int i = 0; i < (int)states.size() && flightCount < 3; i++) {
    JsonArray f = states[i];

    if (f[5].isNull() || f[6].isNull()) continue;  // skip only if no position

    float lon = f[5];
    float lat = f[6];
    float alt = f[7].isNull() ? 0 : f[7];

    String callsign = "UNKNOWN";  // default instead of skipping
    if (!f[1].isNull()) {
      callsign = String((const char*)f[1]);
      callsign.trim();
      if (callsign.length() == 0) callsign = "UNKNWN";  // blank callsign fallback
    }

    flights[flightCount].name     = callsign;
    flights[flightCount].distance = getDistance(userLat, userLon, lat, lon);
    flights[flightCount].alt      = alt;

    Serial.print("Stored flight "); Serial.print(flightCount + 1);
    Serial.print(": "); Serial.println(callsign);

    flightCount++;
  }

  Serial.print("Total flights stored: ");
  Serial.println(flightCount);

  // -------- load first flight into display vars --------
  if (flightCount > 0) {
    flightName     = flights[0].name;
    flightDistance = flights[0].distance;
    flightAlt      = flights[0].alt;

    Serial.println("\n✅ FLIGHTS FETCHED:");
    for (int i = 0; i < flightCount; i++) {
      Serial.print(i + 1); Serial.print(". ");
      Serial.print(flights[i].name);
      Serial.print("  dist: "); Serial.print(flights[i].distance);
      Serial.print("  alt: ");  Serial.println(flights[i].alt);
    }
  }

  http.end();
}