void handleTouch() {
  bool touch = digitalRead(TOUCH_PIN);

  if (touch && !lastTouch) {
    pressStart = millis();
  }

  if (!touch && lastTouch) {
    unsigned long duration = millis() - pressStart;

    if (duration > 500) {
      // LONG PRESS → toggle mode
      flightMode = !flightMode;
      currentFlight = 0;
      if (flightMode) {
        flightName     = flights[0].name;
        flightDistance = flights[0].distance;
        flightAlt      = flights[0].alt;
      }
    } else {
      if (!flightMode) {
        // IMAGE MODE → cycle images
        currentImage = (currentImage + 1) % 6;
      } else {
        // FLIGHT MODE → cycle through 3 flights
        if (flightCount > 0) {
          currentFlight  = (currentFlight + 1) % flightCount;
          flightName     = flights[currentFlight].name;
          flightDistance = flights[currentFlight].distance;
          flightAlt      = flights[currentFlight].alt;
        }
      }
    }
  }

  lastTouch = touch;
}

// -------- IMAGE --------
void drawImage() {
  display.clearDisplay();
  display.drawBitmap(0, 0, images[currentImage], 128, 64, WHITE);
  display.display();
}


