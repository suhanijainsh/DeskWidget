void drawFlight() {
  static String        lastFlight   = "";
  static float         lastDistance = -1;
  static float         shownDistance = 0;
  static float         shownAlt      = 0;
  static bool          anim          = false;
  static unsigned long animStart     = 0;
  static unsigned long lastFrame     = 0;

  // -------- detect new data --------
  if (flightName != lastFlight || flightDistance != lastDistance) {
    lastFlight    = flightName;
    lastDistance  = flightDistance;
    shownDistance = 0;
    shownAlt      = 0;
    anim          = true;
    animStart     = millis();
  }

  // -------- odometer animation --------
  if (anim) {
    float p = (millis() - animStart) / 800.0;
    if (p >= 1.0) { p = 1.0; anim = false; }
    shownDistance = flightDistance * p;
    shownAlt      = flightAlt * p;
  }

  // -------- frame limiter --------
  if (millis() - lastFrame < 40) return;
  lastFrame = millis();

  bool dotOn = (millis() / 700) % 2 == 0;

  display.clearDisplay();

  // ====== TOP: CALLSIGN + FLIGHT INDEX ======
  String name = flightName;
  name.trim();
  if (name.length() > 6) name = name.substring(0, 6);


  display.setTextSize(2);
  display.setTextColor(SH110X_WHITE);

  int nameW      = name.length() * 12;
  int totalW     = nameW + 10;
  int startX     = (128 - totalW) / 2;

  display.setCursor(startX, 0);
  display.print(name);
  display.setCursor(startX + nameW + 10, 0);

  // ====== MIDDLE: DISTANCE ======
  display.setTextSize(2);
  String fullText = String((int)shownDistance) + " km away";
  int distX = (128 - (int)fullText.length() * 12) / 2;
  display.setCursor(distX, 24);
  display.print(fullText);

  // ====== BOTTOM: ALTITUDE ======
  float alt_ft = flightAlt * 3.28084;
  String altText = String((int)(anim ? shownAlt * 3.28084 : alt_ft)) + " ft";
  int altX = (128 - (int)altText.length() * 12) / 2;
  display.setCursor(altX, 46);
  display.print(altText);

  display.display();
}

